{
  "name": "vex-lang-org",
  "version": "0.4.0-rc.39",
  "private": true,
  "packageManager": "bun@1.3.10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:docs": "vitepress dev docs --port 3333",
    "docs:bundle": "node scripts/sync-doc-bundle.mjs",
    "docs:bundle:check": "node scripts/sync-doc-bundle.mjs --check",
    "build": "node scripts/sync-doc-bundle.mjs && vue-tsc -b && vite build && vitepress build docs && mkdir -p dist/docs && cp -r dist-docs/* dist/docs/ && cp dist/index.html dist/404.html",
    "preview": "vite preview"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "@supabase/supabase-js": "^2.115.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/extension-code-block-lowlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "dompurify": "^3.4.14",
    "entities": "8.0.0",
    "lowlight": "^3.3.0",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.11",
    "monaco-editor": "^0.56.0",
    "monaco-editor-textmate": "^4.0.0",
    "monaco-textmate": "^3.0.1",
    "turndown": "^7.2.4",
    "vscode-oniguruma": "^2.0.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/dompurify": "^3.2.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitepress": "^2.0.0-alpha.20",
    "vue-tsc": "^3.3.11"
  }
}
